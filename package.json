{
  "name": "5e-database",
  "version": "4.4.0",
  "description": "Database for 5e-srd-api",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --experimental-sqlite app/server.js",
    "lint": "eslint . --config eslint.config.mjs",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:campaign": "node ./node_modules/vitest/vitest.mjs run tests/integration/campaign",
    "coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "build:ts": "tsc --project scripts",
    "db:refresh": "npm run build:ts && node --experimental-sqlite scripts/built/dbRefresh.js",
    "db:seed": "npm run build:ts && node --experimental-sqlite scripts/built/dbSeed.js",
    "db:seed:azure": "npm run build:ts && node scripts/built/dbSeedAzureSql.js",
    "db:seed:mongodb": "npm run build:ts && node scripts/built/dbSeedMongo.js",
    "db:seed:online": "npm run build:ts && node scripts/built/dbSeedOnline.js",
    "db:update": "npm run build:ts && node --experimental-sqlite scripts/built/dbUpdate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5e-bits/5e-database.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/5e-bits/5e-database/issues"
  },
  "homepage": "https://github.com/5e-bits/5e-database#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@types/deep-diff": "1.0.5",
    "@types/mssql": "9.1.9",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/eslint-plugin": "1.6.13",
    "deep-diff": "1.0.2",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "glob": "13.0.6",
    "globals": "17.4.0",
    "jsdom": "29.0.1",
    "redis": "5.11.0",
    "tinyexec": "1.0.4",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@3d-dice/dice-box": "1.1.4",
    "@azure/identity": "4.13.1",
    "@types/sql.js": "1.4.10",
    "mongodb": "6.16.0",
    "mssql": "12.2.1",
    "sql.js": "1.14.1"
  }
}